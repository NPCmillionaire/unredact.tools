{
  "manifest_version": 3,
  "name": "unredact.tools",
  "short_name": "unredact",
  "version": "0.1.0",
  "description": "See what a file gives away before you upload it. Catches GPS, authors, fake redactions and hidden text, then cleans it. 100% local.",
  "homepage_url": "https://unredact.tools",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "unredact.tools",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options/options.html",
  "permissions": ["contextMenus", "storage", "scripting", "offscreen", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
